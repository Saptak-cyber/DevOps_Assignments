# Copy to terraform.tfvars and adjust. No credentials belong here: Terraform reads AWS
# credentials from the environment (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) or ~/.aws.
aws_region         = "ap-south-1"
environment        = "dev"
owner              = "saptak-banerjee"
cluster_name       = "clinicdesk-eks"
kubernetes_version = "1.36"
vpc_cidr           = "10.42.0.0/16"

node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3

# Narrow the public API endpoint to your own IP, e.g. ["203.0.113.10/32"]
endpoint_public_access_cidrs = ["0.0.0.0/0"]
