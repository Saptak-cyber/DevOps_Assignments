# Provider plugins downloaded by `terraform init`
.terraform/

# State (can contain sensitive values) and its backups
*.tfstate
*.tfstate.*

# Saved plans, crash logs
*.tfplan
tfplan
crash.log
crash.*.log

# Real variable files; only the example is committed
*.tfvars
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.lock.hcl IS committed: it pins provider versions and checksums.
